{
  "expo": {
    "name": "GFH",
    "slug": "gfh-movil",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "gfh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#1F5E4A",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#1F5E4A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.gfh.movil",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "GFH",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gfh.movil",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F5E4A"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/rutas-cortas-windows",
      "@sentry/react-native",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
