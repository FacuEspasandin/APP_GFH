# ---------------------------------------------------------------------------
# Backend. Copiar a apps/backend/.env y completar. Nunca commitear el .env real.
# ---------------------------------------------------------------------------

# PostgreSQL (Supabase como proveedor de infraestructura; auth es propia)
# DATABASE_URL usa el pooler (pgbouncer) para runtime.
# DIRECT_URL apunta al puerto directo — Prisma Migrate lo necesita.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# JWT — el backend NO arranca sin esto (minimo 32 caracteres).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"

# El refresh token NO es un JWT: es un valor opaco aleatorio guardado hasheado
# con SHA-256 en la tabla `sesion`, con rotacion en cada uso. No necesita
# secreto propio — no se firma nada, se compara contra la base.
# Vigencia: 30 dias, definida en codigo (auth.service.ts).

# RevenueCat — la suscripcion se escribe SOLO desde el webhook (regla no negociable 6)
REVENUECAT_WEBHOOK_AUTH_HEADER=""
REVENUECAT_API_KEY=""

# Monografias — Farmanuario Uruguay. Nunca se expone el proveedor en la UI (regla 9).
MONOGRAFIAS_API_BASE_URL=""
MONOGRAFIAS_API_KEY=""
MONOGRAFIAS_CACHE_TTL_SECONDS="21600"

# Umbral por defecto de adulto mayor (condicion sintetica, motor §6.2).
# Es configurable por usuario en ConfiguracionUsuario; esto es solo el default.
UMBRAL_ADULTO_MAYOR_DEFAULT="65"

NODE_ENV="development"
# En un host desplegado NO cargar PORT: lo inyecta el proveedor y el backend ya
# lo lee. 3333 es solo el valor local (el 3000 lo ocupa GFH web).
PORT="3333"

# Origenes permitidos para CORS, separados por coma. Solo aplica al navegador:
# la app nativa no manda cabecera Origin. Sin valor, CORS queda cerrado.
CORS_ORIGENES="http://localhost:8081,http://127.0.0.1:8081"

# Bloquea el acceso si la suscripcion no esta activa.
# EXIGIR_SUSCRIPCION="true"

# Proveedor de vision para la carga por foto. Sin esto el endpoint responde
# "no implementado" y la carga por texto sigue andando.
VISION_API_KEY=""
